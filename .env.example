# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 已实现 /api/interpret 和 /api/heming 两个接口，填好下面任一组即可用。
# 排盘本身不需要任何 API Key；只有 AI 解读 / 合盘分析需要。

# 方案一：DeepSeek（国内访问快，便宜）
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-chat   # 可选，默认 deepseek-chat

# 方案二：Kimi / Moonshot AI（OpenAI 兼容，长上下文，中文好）
# AI_PROVIDER=kimi
# KIMI_API_KEY=your-kimi-api-key
# KIMI_MODEL=kimi-k3.1-pro       # 可选，默认 kimi-k3.1-pro；还有 kimi-k3.1-pro-highspeed（高速版）

# 方案三：其他 OpenAI 兼容服务（OpenAI / 小米 mimo / 自建 / 中转）
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
